# --- LLM Provider Configuration ---
# Default: Ollama (self-hosted, zero cost)
# Set to "ollama", "anthropic", or "openai"
LLM_PROVIDER=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Anthropic (Claude) settings — only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI settings — only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...

# --- Data Connector Keys ---
# Meta Marketing API
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# GA4
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_KEY_PATH=

# TikTok Marketing API
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# Shopify
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# LinkedIn Marketing API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# --- Supabase (Database) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://...

# --- Model Storage ---
# S3 or R2 for trained model artifacts
MODEL_STORAGE_BACKEND=local
MODEL_STORAGE_PATH=./model_artifacts

# --- Celery / Job Queue ---
REDIS_URL=redis://localhost:6379/0

# --- App Settings ---
ENV=development
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# --- PyTensor Compiler ---
# Set to MinGW g++ path for C-compiled PyTensor (10-50x faster model training).
# Find: C:/Users/arpit/AppData/Local/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin/g++.exe
# PYTENSOR_FLAGS=cxx=C:/Users/arpit/AppData/Local/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin/g++.exe

